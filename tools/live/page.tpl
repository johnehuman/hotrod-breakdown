<title>Week 10 Live Odds</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700;800&family=Playfair+Display:wght@900&family=Source+Sans+3:wght@400;600;700&display=swap">
<style>
:root{--bg:#f4f3ef;--card:#fff;--ink:#1d1d1f;--muted:#5f6168;--line:#e2e0da;--accent:#c8102e;--win:#13753f;--lose:#b3202a;--stake:#f7e7a6;--stakeline:#e5cf73;--bar:#ecebe6;
  --display:"Poppins","Helvetica Neue",Arial,sans-serif;--serif:"Playfair Display",Georgia,serif;--body:"Source Sans 3","Helvetica Neue",Arial,sans-serif}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#151517;--card:#1f1f22;--ink:#f1f0ec;--muted:#a3a4ab;--line:#34343a;--accent:#ff4d5e;--win:#41c27a;--lose:#ff6b6b;--stake:#3a3216;--stakeline:#6b5a1d;--bar:#2c2c31}}
:root[data-theme="dark"]{--bg:#151517;--card:#1f1f22;--ink:#f1f0ec;--muted:#a3a4ab;--line:#34343a;--accent:#ff4d5e;--win:#41c27a;--lose:#ff6b6b;--stake:#3a3216;--stakeline:#6b5a1d;--bar:#2c2c31}
*,*::before,*::after{box-sizing:border-box}
[hidden]{display:none!important}
body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.5 var(--body);-webkit-font-smoothing:antialiased}
.gut{max-width:760px;margin:0 auto;padding:0 16px}
.mast{background:var(--card);border-bottom:4px solid var(--accent)}
.mast .gut{padding-block:18px 14px;display:grid;gap:6px}
.kicker{font:700 11px var(--display);letter-spacing:.16em;text-transform:uppercase;color:var(--muted)}.kicker b{color:var(--accent)}
h1{margin:0;font:700 clamp(28px,6vw,44px)/1 var(--display);text-transform:uppercase}
.status{display:flex;flex-wrap:wrap;align-items:center;gap:10px 14px}
.live{display:inline-flex;align-items:center;gap:6px;font:700 11px var(--display);letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}
.live::before{content:"";width:8px;height:8px;border-radius:50%;background:var(--muted)}
.live.on{color:var(--accent)}.live.on::before{background:var(--accent);animation:pulse 1.6s infinite}
@keyframes pulse{50%{opacity:.25}}
button{font:600 13px var(--display);color:var(--ink);background:var(--card);border:1.5px solid var(--ink);padding:6px 12px;cursor:pointer;border-radius:2px}
button:disabled{opacity:.5;cursor:default}
.banner{background:var(--stake);border:1px solid var(--stakeline);padding:10px 14px;font-size:14px}
.banner button{margin-left:8px}
main.gut{padding-block:20px 48px;display:grid;gap:20px}
h2{margin:6px 0 0;text-align:center;font:900 clamp(24px,5vw,34px)/1.05 var(--serif);text-transform:uppercase}
h2::after{content:"";display:block;width:48px;height:3px;background:var(--accent);margin:10px auto 0}
.hint{margin:-8px auto 0;text-align:center;color:var(--muted);max-width:56ch;font-size:14px}
.card{background:var(--card);border:1px solid var(--line);border-top:3px solid var(--ink);padding:14px 16px;min-width:0}
.games{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:8px}
.gm{background:var(--card);border:1px solid var(--line);border-top:3px solid var(--ink);padding:12px 14px;display:grid;gap:8px}
.gm.fin{border-top-color:var(--muted)}
.side{display:grid;grid-template-columns:1fr auto;align-items:baseline;gap:2px 10px}
.side .nm{font:700 16px var(--display)}.side .sc{font:800 22px/1 var(--display);font-variant-numeric:tabular-nums;text-align:right}
.side small{color:var(--muted);font-size:12.5px}.side small.r{text-align:right}
.side.lead .nm::after{content:" ◀";color:var(--accent);font-size:12px}
.wp{display:flex;height:8px;background:var(--bar);border-radius:4px;overflow:hidden}
.wp i{display:block;background:var(--ink)}
.wpl{display:flex;justify-content:space-between;font:600 12px var(--display);color:var(--muted)}
.stk{font-size:13px;color:var(--muted);border-top:1px solid var(--line);padding-top:6px}
.stk b{color:var(--ink);font-weight:700}
.movers{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px}
.mv{background:var(--card);border:1px solid var(--line);border-top:3px solid var(--accent);padding:12px 14px}
.mv em{display:block;font:700 11px var(--display);font-style:normal;letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}
.mv b{display:block;font:700 18px var(--display);margin-top:2px}.mv .big{font:800 26px/1.1 var(--display)}
.mv p{margin:4px 0 0;font-size:13.5px;color:var(--muted)}
.up{color:var(--win)}.dn{color:var(--lose)}.flat{color:var(--muted)}
table{width:100%;border-collapse:collapse}
th{font:600 11px var(--display);letter-spacing:.05em;text-transform:uppercase;color:var(--muted);text-align:right;padding:6px 4px;border-bottom:2px solid var(--ink);vertical-align:bottom}
th:first-child,td:first-child{text-align:left}
td{padding:9px 4px;border-bottom:1px solid var(--line);text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap}
td:first-child{white-space:normal}td .nm{font:600 15px var(--display);display:block;line-height:1.2}td small{color:var(--muted);font-size:12.5px}
td.was{color:var(--muted);font:600 14px var(--display)}td.is{font:700 15px var(--display)}td.mvn{font:700 14px var(--display)}
tr.cut td{border-bottom:2px solid var(--accent)}
.method{font-size:13px;color:var(--muted);margin:0}
.busy{opacity:.55;transition:opacity .2s}
.pick{display:grid;grid-template-columns:1fr auto 1fr;border:1.5px solid var(--ink);border-radius:2px;overflow:hidden}
.pick button{border:0;border-radius:0;padding:10px 6px;font-size:14px;background:var(--card);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.pick button+button{border-left:1.5px solid var(--ink)}
.pick button[aria-pressed=true]{background:var(--ink);color:var(--card)}
.pick.on{border-color:var(--accent)}
.scen{position:sticky;top:0;z-index:5;background:var(--ink);color:var(--card);padding:10px 14px;display:flex;flex-wrap:wrap;gap:8px 12px;align-items:center;justify-content:space-between;font-size:14px}
.scen b{font-family:var(--display)}
.scen button{background:transparent;color:var(--card);border-color:var(--card)}
</style>
<header class="mast"><div class="gut">
  <div class="kicker"><b>Hot Rod</b> · The Breakdown · Live tracker</div>
  <h1>Week 10 Live Odds</h1>
  <div class="status"><span class="live" id="stamp">Connecting…</span><button id="refresh" hidden>Refresh now</button></div>
</div></header>
<div class="scen" id="scen" hidden><span id="scentext"></span><button id="reset">Back to live</button></div>
<main class="gut">
  <div class="banner" id="banner" hidden></div>
  <h2>Biggest Movers</h2>
  <p class="hint">Change since Thursday's Week 9 issue.</p>
  <div class="movers" id="movers"></div>
  <h2>Playoff Odds</h2>
  <p class="hint">Records show where each team lands if every current leader holds. Top 6 make it; the red line is the cut.</p>
  <section class="card"><table><thead><tr><th>Manager</th><th>Pre-game</th><th class="nowh">Now</th><th>Move</th></tr></thead><tbody id="odds"></tbody></table></section>
  <h2>Bye Odds</h2>
  <p class="hint">Seeds 1–2 get a first-round bye.</p>
  <section class="card"><table><thead><tr><th>Manager</th><th>Pre-game</th><th class="nowh">Now</th><th>Move</th></tr></thead><tbody id="byes"></tbody></table></section>
  <h2>What If</h2>
  <p class="hint">Lock in Week 10 winners to see how the odds above would change. Tap <b>Live</b> to undo.</p>
  <div class="games" id="games"></div>
  <p class="method">How this works: the same model as the Week 9 issue. Each team's Week 10 score is its live score plus what ESPN projects for the rest of its lineup, with less uncertainty as fewer points remain. Weeks 11–14 are simulated as before (60,000 seasons per update). Seeding: record, then points for. </p>
</main>
<script>
__SIM__
const S=__S__;const SERVER="League Loom",TOOL="fantasy_get_matchups";
const INPUT={league_query:"Hot Rod",season:2026,week:10,live:true,response_format:"json",sport:"NFL"};
const $=id=>document.getElementById(id),N=60000,n=S.keys.length;
const pct=x=>x>=99.95?'>99.9%':x>0&&x<0.05?'<0.1%':x.toFixed(1)+'%';
const p0=x=>x>=99.5?'>99%':x>0&&x<0.5?'<1%':Math.round(x)+'%';
const mvc=x=>{const r=Math.round(x*10)/10;return r===0?'<span class="flat">0.0</span>':`<span class="${r>0?'up':'dn'}">${r>0?'+':'−'}${Math.abs(r).toFixed(1)}</span>`};
const esc=s=>String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'})[c]);
let lastWk=null,curWk=null;const forced=S.sched[0].map(()=>null);const scenOn=()=>forced.some(Boolean);

function render(R,wk){
  const nm=S.names;
  // games
  $('games').innerHTML=R.games.map((g,j)=>{const f=forced[j];
    const pb=(v,l)=>`<button data-g="${j}" data-v="${v}" aria-pressed="${(f||'')===v}">${l}</button>`;
    return `<div class="pick${f?' on':''}">${pb('a',nm[g.a])}${pb('','Live')}${pb('h',nm[g.h])}</div>`}).join('');
  document.querySelectorAll('.nowh').forEach(t=>t.textContent=scenOn()?'Scenario':'Now');
  const picks=R.games.map((g,j)=>forced[j]?`${nm[forced[j]==='a'?g.a:g.h]} over ${nm[forced[j]==='a'?g.h:g.a]}`:null).filter(Boolean);
  $('scen').hidden=!picks.length;$('scentext').innerHTML='<b>Scenario:</b> '+picks.join(' · ');
  // records if leaders hold
  const W=S.W.slice(),L=S.W.map(w=>9-w);
  R.games.forEach((g,j)=>{const aw=forced[j]?forced[j]==='a':wk?wk[g.a].live>=wk[g.h].live&&!(wk[g.a].live===wk[g.h].live&&g.pa<50):g.pa>=50;W[aw?g.a:g.h]++;L[aw?g.h:g.a]++});
  // movers
  const mv=S.keys.map((k,i)=>{const dp=R.po[i]-S.prePO[i],db=R.by[i]-S.preBY[i];return Math.abs(db)>Math.abs(dp)?{i,what:'Bye',from:S.preBY[i],to:R.by[i],d:db}:{i,what:'Playoff',from:S.prePO[i],to:R.po[i],d:dp}})
    .sort((a,b)=>Math.abs(b.d)-Math.abs(a.d)).slice(0,4);
  $('movers').innerHTML=mv.map(m=>`<div class="mv"><em>${m.what} odds</em><b>${nm[m.i]}</b><div class="big ${m.d>=0.05?'up':m.d<=-0.05?'dn':'flat'}">${m.d>=0?'+':'−'}${Math.abs(m.d).toFixed(1)}</div><p>${pct(m.from)} → ${pct(m.to)}</p></div>`).join('');
  const table=(id,pre,now,cut)=>{const ord=[...Array(n).keys()].sort((a,b)=>now[b]-now[a]||R.po[b]-R.po[a]||pre[b]-pre[a]);
    $(id).innerHTML=ord.map((i,r)=>`<tr class="${r===cut-1?'cut':''}"><td><span class="nm">${nm[i]}</span><small>${S.W[i]}-${9-S.W[i]} → ${W[i]}-${L[i]}</small></td><td class="was">${pct(pre[i])}</td><td class="is">${pct(now[i])}</td><td class="mvn">${mvc(now[i]-pre[i])}</td></tr>`).join('')};
  table('odds',S.prePO,R.po,6);table('byes',S.preBY,R.by,2);
}
function stake(i,w,l){if(w[0]==null||l[0]==null)return `<b>${S.names[i]}</b>: decided`;
  const swing=w[0]-l[0];if(Math.abs(swing)<0.5&&w[1]-l[1]<0.5)return `<b>${S.names[i]}</b>: little at stake`;
  const useBye=Math.abs(w[1]-l[1])>Math.abs(swing);
  return `<b>${S.names[i]}</b>: ${useBye?'bye':'playoffs'} ${p0(useBye?w[1]:w[0])} with a win, ${p0(useBye?l[1]:l[0])} with a loss`}

function compute(wk){curWk=wk;document.body.classList.add('busy');setTimeout(()=>{const R=runSim(S,wk,N,scenOn()?forced:null);render(R,wk);document.body.classList.remove('busy')},20)}
function stampAt(at,cached){const st=$('stamp');if(!at){st.textContent='Pre-game odds';st.className='live';return}
  const t=new Date(at).toLocaleTimeString('en-US',{hour:'numeric',minute:'2-digit',timeZone:'America/New_York'});
  const d=new Date(at).toLocaleDateString('en-US',{weekday:'short',timeZone:'America/New_York'});
  st.textContent=`Live as of ${t} ET ${d}`;st.className='live on'}
function banner(html,btn){const b=$('banner');if(!html){b.hidden=true;return}b.innerHTML=html;b.hidden=false;if(btn){const x=document.createElement('button');x.textContent=btn.label;x.onclick=btn.fn;b.appendChild(x)}}
function onData(result){
  const {wk,at,allFinal}=parseMatchups(S,result&&result.payload);
  if(!wk){banner('<b>Live data came back incomplete.</b> Showing the last good numbers.');return}
  banner(allFinal?'<b>All Week 10 games are final.</b> These are the end-of-week odds, before any stat corrections.':null);
  const key=JSON.stringify(wk);stampAt(at||(result.cache&&result.cache.storedAt));
  if(key===lastWk)return;lastWk=key;compute(wk);
}
function onError(e,mcp){
  const c=e&&e.code;
  if(c==='needs_reauth'){lastWk=null;compute(null);banner(`<b>League Loom needs reconnecting.</b> Reconnect it in claude.ai Settings → Connectors, then reload. Showing pre-game odds.`)}
  else if(c==='server_not_connected'||c==='selection_required'||c==='server_not_found'){lastWk=null;compute(null);banner(`<b>Live scores need the League Loom connector.</b> Add it in claude.ai Settings → Connectors${c==='selection_required'?' (or choose which League Loom to use when prompted)':''}. Showing pre-game odds.`)}
  else if(c==='approval_required'||c==='not_in_manifest'||c==='consent_required'){banner('<b>Live scores need your OK</b> to read Hot Rod matchups through League Loom.',{label:'Allow live scores',fn:()=>manual(mcp)})}
  else if(c==='blocked_by_policy'){banner('<b>Your organization blocks this League Loom tool here.</b> Showing pre-game odds.')}
  else if(c==='server_unavailable'||c==='rate_limited'||c==='upstream_error'){banner(`<b>ESPN data didn't come through just now.</b> ${lastWk?'Keeping the last update; ':''}it will try again automatically.`)}
  else if(c==='tool_error'){banner(`<b>League Loom reported a problem:</b> ${esc(e.message||'unknown error')}. Will try again on the next update.`)}
  else{banner('<b>Live updates aren\'t available in this view.</b> Showing pre-game odds.')}
}
async function manual(mcp){const b=$('refresh');b.disabled=true;
  try{const r=await mcp.callTool(SERVER,TOOL,INPUT,{cache:{staleTime:0,gcTime:600000,refresh:true}});banner(null);onData(r)}catch(e){onError(e,mcp)}finally{b.disabled=false}}
$('games').addEventListener('click',e=>{const b=e.target.closest('button[data-g]');if(!b)return;forced[+b.dataset.g]=b.dataset.v||null;compute(curWk)});
$('reset').onclick=()=>{forced.fill(null);compute(curWk)};
const SNAP=__SNAP__;
if(SNAP){const {wk,at}=parseMatchups(S,SNAP);compute(wk);const t=new Date(at),o={timeZone:'America/New_York'};$('stamp').textContent=`Snapshot · ${t.toLocaleTimeString('en-US',{...o,hour:'numeric',minute:'2-digit'})} ET ${t.toLocaleDateString('en-US',{...o,weekday:'short'})}`;$('stamp').className='live';
  document.querySelector('.method').insertAdjacentText('beforeend',' This shared copy is a snapshot; it updates when John posts a new one.')}
else{compute(null);stampAt(null)}
if(!SNAP)(async()=>{
  const mcp=window.claude&&window.claude.use?await window.claude.use("mcp").catch(()=>null):null;
  if(!mcp){banner('<b>Live updates only work for the owner, opened in Claude with League Loom connected.</b> Showing pre-game odds from Thursday\'s issue.');return}
  $('refresh').hidden=false;$('refresh').onclick=()=>manual(mcp);
  mcp.watchTool(SERVER,TOOL,INPUT,ev=>{if(ev.type==='data')onData(ev.result);else onError(ev.error,mcp)},{cache:{staleTime:60000,gcTime:600000},refetchInterval:120000});
})();
</script>
